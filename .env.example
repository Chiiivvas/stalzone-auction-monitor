# --- Auction API (official, https://eapi.stalcraft.net/reference) ---
# Token of your EXBO-approved application (App token). Never commit it.
STALZONE_API_TOKEN=
STALZONE_API_BASE_URL=https://eapi.stalzone.com
STALZONE_REGION=ru

# Optional sorting for the lots endpoint. Leave empty unless you verified the
# exact parameter values in the Swagger reference.
LOTS_SORT=
LOTS_ORDER=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning ---
DB_PATH=data/monitor.db
LOG_DIR=logs
REQUEST_TIMEOUT=10
# Minimum pause between two API requests (seconds). Protects against rate limit.
MIN_REQUEST_GAP=0.25
MAX_RETRIES=3
LOTS_PAGE_SIZE=200
# Max pages per item per cycle (page = LOTS_PAGE_SIZE lots)
MAX_PAGES=2
